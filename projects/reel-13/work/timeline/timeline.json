"segments": [
{
"id": "c01",
"src_in": 0.8667,
"src_out": 3.7667,
"speed": 1.0,
"text": "I am going to bulk until I look like an anime villain."
},
{
"id": "c02",
"src_in": 5.6667,
"src_out": 7.4667,
"speed": 1.0,
"text": "This is Toji Fushiguro."
},
{
"id": "c03",
"src_in": 10.1,
"src_out": 10.9333,
"speed": 1.0,
"text": "Wide back,"
},
{
"id": "c04",
"src_in": 11.2,
"src_out": 15.2333,
"speed": 1.0,
"text": "arms like carved stone, and a V-taper so sharp it looks fake."
},
{
"id": "c05",
"src_in": 16.6333,
"src_out": 20.0667,
"speed": 1.0,
"text": "But whenever I tell people they can build a body like this,"
},
{
"id": "c06",
"src_in": 21.4667,
"src_out": 23.8,
"speed": 1.0,
"text": "I hear the same three excuses."
},
{
"id": "c07",
"src_in": 25.2667,
"src_out": 28.1,
"speed": 1.0,
"text": "I don't have the genetics. / I don't have the time."
},
{
"id": "c08",
"src_in": 28.4333,
"src_out": 30.0667,
"speed": 1.0,
"text": "It's not possible naturally."
},
{
"id": "c09",
"src_in": 32.0,
"src_out": 34.6333,
"speed": 1.0,
"text": "So I am going to show you what is possible"
},
{
"id": "c10",
"src_in": 36.7667,
"src_out": 39.3,
"speed": 1.0,
"text": "This is me after seven years of training."
},
{
"id": "c11",
"src_in": 40.9667,
"src_out": 43.6667,
"speed": 1.0,
"text": "Decent, / but I'm not a genetic freak."
},
{
"id": "c12",
"src_in": 45.3333,
"src_out": 50.1667,
"speed": 1.0,
"text": "I am twenty-seven. / I work full time in tech, and I'm also a fitness coach."
},
{
"id": "c13",
"src_in": 51.4667,
"src_out": 55.1667,
"speed": 1.0,
"text": "And I have been a type one diabetic since I was twelve."
},
{
"id": "c14",
"src_in": 56.3,
"src_out": 57.8333,
"speed": 1.0,
"text": "If I can build this body,"
},
{
"id": "c15",
"src_in": 58.0667,
"src_out": 58.8333,
"speed": 1.0,
"text": "so can you."
},
{
"id": "c16",
"src_in": 60.6667,
"src_out": 62.9333,
"speed": 1.0,
"text": "I'm already two months into this bulk,"
},
{
"id": "c17",
"src_in": 64.6,
"src_out": 65.7,
"speed": 1.0,
"text": "but from today,"
},
{
"id": "c18",
"src_in": 65.8667,
"src_out": 67.2667,
"speed": 1.0,
"text": "I'm filming all of it."
},
{
"id": "c19",
"src_in": 69.1,
"src_out": 69.9,
"speed": 1.0,
"text": "Training,"
},
{
"id": "c20",
"src_in": 70.0333,
"src_out": 70.6667,
"speed": 1.0,
"text": "food,"
},
{
"id": "c21",
"src_in": 70.8667,
"src_out": 71.7,
"speed": 1.0,
"text": "supplements"
},
{
"id": "c22",
"src_in": 73.1333,
"src_out": 75.4,
"speed": 1.0,
"text": "The wins and the days it goes wrong."
},
{
"id": "c23",
"src_in": 77.0,
"src_out": 78.1333,
"speed": 1.0,
"text": "How long will it take?"
},
{
"id": "c24",
"src_in": 78.2,
"src_out": 79.8667,
"speed": 1.0,
"text": "Six months? A year?"
},
{
"id": "c25",
"src_in": 80.3333,
"src_out": 81.0333,
"speed": 1.0,
"text": "I don't know,"
},
{
"id": "c26",
"src_in": 81.3,
"src_out": 83.6667,
"speed": 1.0,
"text": "but I'm not stopping until I look like him"
}
],
